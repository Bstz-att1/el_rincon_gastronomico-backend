# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================
PORT=3000

# ============================================
# CONFIGURACIÓN DE BASE DE DATOS MySQL
# ============================================
DB_HOST=localhost
DB_USER=app_user_dario
DB_PASSWORD=#ADSO_node
DB_NAME=rincon_gastronomico
DB_PORT=3306

# ============================================
# CONFIGURACIÓN JWT (JSON Web Tokens)
# ============================================

# Clave secreta para firmar los tokens JWT.
# REQUISITOS DE SEGURIDAD OBLIGATORIOS:
#   - Mínimo 32 caracteres (recomendado 64+)
#   - Usar caracteres aleatorios (letras, números, símbolos)
#   - NUNCA reutilizar entre proyectos
#   - NUNCA subir al repositorio (solo este .env.example)
# Generar un secreto seguro con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_SEGURO_DE_AL_MENOS_32_CARACTERES

# Tiempo de vida del token JWT.
# Ejemplos: "15m" (15 minutos), "1h" (1 hora), "8h" (8 horas), "1d" (1 día)
# Usar tiempos cortos mejora la seguridad (recomendado: máximo 8h para apps administrativas)
JWT_EXPIRES_IN=8h

# Identificador del emisor del token (opcional - mejora la validación multi-servicio)
JWT_ISSUER=rincon-gastronomico-api

# Identificador del receptor esperado del token (opcional)
JWT_AUDIENCE=rincon-gastronomico-app
