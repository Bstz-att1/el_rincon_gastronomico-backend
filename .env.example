# ============================================
#   PLANTILLA DE VARIABLES DE ENTORNO
#   Rincón Gastronómico — Backend API
# ============================================
#
# INSTRUCCIONES:
#   1. Copia este archivo:  cp .env.example .env
#   2. Rellena los valores con los datos reales de tu entorno.
#   3. NUNCA subas el archivo .env al repositorio (ya está en .gitignore).
#
# Genera un JWT_SECRET seguro con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================

# ── Servidor ─────────────────────────────────────────────────────────────────
# Puerto en el que escuchará la API (defecto: 3000)
PORT=3000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# ── Base de datos MySQL ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=app_user_dario
DB_PASSWORD=#ADSO_node
DB_NAME=rincon_gastronomico

# ── JWT (JSON Web Token) ──────────────────────────────────────────────────────
# OBLIGATORIO: mínimo 32 caracteres, preferiblemente 64+ caracteres aleatorios.
# La app NO arrancará si este valor falta o es inseguro.
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_SEGURO_DE_AL_MENOS_32_CARACTERES

# Tiempo de vida del token (ej: "15m", "1h", "8h", "1d")
JWT_EXPIRES_IN=8h

# Identificador del emisor (opcional — mejora validación multi-servicio)
JWT_ISSUER=rincon-gastronomico-api

# Identificador del receptor esperado (opcional)
JWT_AUDIENCE=rincon-gastronomico-app

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origen permitido para consumir la API desde el frontend.
# Desarrollo con Vite/React : http://localhost:5173
# Producción                 : https://tudominio.com
# Sin restricción (dev only) : *
CORS_ORIGIN=http://localhost:5173
